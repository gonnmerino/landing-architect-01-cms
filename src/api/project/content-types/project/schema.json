{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ProjectName": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "ProjectFavorite": {
      "type": "boolean",
      "default": true
    },
    "Carousel": {
      "type": "boolean"
    },
    "DateOfProject": {
      "type": "date"
    },
    "slug": {
      "type": "uid",
      "targetField": "ProjectName",
      "required": true
    },
    "Image": {
      "type": "component",
      "component": "shared.images",
      "repeatable": true
    },
    "ProjectFeatured": {
      "type": "component",
      "component": "shared.feature",
      "repeatable": true
    }
  }
}
